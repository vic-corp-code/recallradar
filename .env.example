NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

CONVEX_DEPLOYMENT=dev:benevolent-ocelot-389
NEXT_PUBLIC_CONVEX_URL=https://benevolent-ocelot-389.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://benevolent-ocelot-389.convex.site

# Receipt extraction provider:
# - auto: prefer OpenRouter, then OpenAI, then fallback to mock
# - openai: require OpenAI and fail when unavailable
# - openrouter: require OpenRouter and fail when unavailable
# - mock: always use local mock extraction
RECEIPT_EXTRACTION_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_RECEIPT_MODEL=google/gemma-4-31b-it:free
