NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

CONVEX_DEPLOYMENT=dev:benevolent-ocelot-389
NEXT_PUBLIC_CONVEX_URL=https://benevolent-ocelot-389.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://benevolent-ocelot-389.convex.site

# Optional for mobile/LAN/Tailscale dev:
# Comma-separated host patterns allowed to access Next.js dev assets.
# Example: ALLOWED_DEV_ORIGINS=192.168.1.187,100.104.146.27,*.my-tailnet.ts.net
ALLOWED_DEV_ORIGINS=

# Receipt extraction:
# - mock: use local mock extraction (no API key needed)
# - unset or any other value: use OpenRouter
RECEIPT_EXTRACTION_MODE=mock
OPENROUTER_API_KEY=
OPENROUTER_RECEIPT_MODEL=google/gemma-4-31b-it:free
